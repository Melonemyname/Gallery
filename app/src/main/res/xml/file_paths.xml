<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
      Einziger freigegebener Ordner: Server-Dateien werden vor dem Teilen hierhin gecacht
      (siehe sharedContentUri). Lokale Medien laufen direkt über ihre content://-URI und
      brauchen keinen Eintrag; weitere Pfade würden nur unnötig viel freigeben.
    -->
    <cache-path name="shared_cache" path="shared/" />
</paths>
